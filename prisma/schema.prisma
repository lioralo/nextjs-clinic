// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  ADMIN
  CLINICIAN
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum AppointmentKind {
  APPOINTMENT
  VACANCY
  BLOCK
}

enum MeetingType {
  IN_PERSON
  ONLINE
}

enum PatientStatus {
  ONGOING
  CANDIDATE
  WAITING
  ARCHIVED
}

enum PatientType {
  PRIVATE
  RESIDENCY
  GROUP
  INITIAL_INTAKE
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientsOwned Patient[]     @relation("PatientOwner")
  appointments  Appointment[] @relation("ProviderAppointments")
  notesAuthored Note[]        @relation("NoteAuthors")
}

model Patient {
  id String @id @default(cuid())

  firstName String
  lastName  String
  phone     String?
  email     String?
  notesText String?
  birthDate DateTime?
  idNumber  String?

  status      PatientStatus @default(CANDIDATE)
  patientType PatientType   @default(PRIVATE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String?
  owner   User?   @relation("PatientOwner", fields: [ownerId], references: [id])

  appointments Appointment[]
  notes        Note[]
}

model Appointment {
  id String @id @default(cuid())

  patientId  String?
  providerId String

  startAt DateTime
  endAt   DateTime
  status  AppointmentStatus @default(SCHEDULED)
  kind    AppointmentKind   @default(APPOINTMENT)

  title       String?
  meetingType MeetingType @default(IN_PERSON)
  meetingLink String?

  isRecurring              Boolean   @default(false)
  recurrenceIntervalWeeks  Int?
  recurrenceEndDate        DateTime?
  recurrenceGroupId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient  Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  provider User     @relation("ProviderAppointments", fields: [providerId], references: [id])
}

model Note {
  id String @id @default(cuid())

  patientId String
  authorId  String

  content       String
  sessionNumber Int?
  noteDate      DateTime?
  keyTopics     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  author  User    @relation("NoteAuthors", fields: [authorId], references: [id])
}
