// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  ADMIN
  CLINICIAN
  PATIENT
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum AppointmentKind {
  APPOINTMENT
  VACANCY
  BLOCK
}

enum MeetingType {
  IN_PERSON
  ONLINE
}

enum PatientStatus {
  ONGOING
  CANDIDATE
  WAITING
  ARCHIVED
}

enum PatientType {
  PRIVATE
  RESIDENCY
  GROUP
  INITIAL_INTAKE
}

enum RecurrenceExceptionKind {
  SKIP
  MOVED
}

enum CancelRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GroupSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PENDING
  PRESENT
  MISSED
}

enum NotificationCategory {
  SYSTEM
  ADMIN_BROADCAST
  APPOINTMENT
  CANCEL
  RESOURCE
  CONTACT
}

enum TreatmentPlanStatus {
  ACTIVE
  COMPLETED
  REVIEW
  DISCONTINUED
}

enum GoalStatus {
  ACTIVE
  IN_PROGRESS
  ACHIEVED
  DISCONTINUED
  REVISED
}

model User {
  id                  String   @id @default(cuid())
  username            String   @unique
  passwordHash        String
  role                UserRole @default(ADMIN)
  email               String?
  isActive            Boolean  @default(true)
  forcePasswordChange Boolean  @default(false)
  patientId           String?  @unique
  totpSecret          String?
  totpEnabled         Boolean  @default(false)
  totpRecoveryHashes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient            Patient?            @relation("PortalAccount", fields: [patientId], references: [id])
  patientsOwned      Patient[]           @relation("PatientOwner")
  appointments       Appointment[]       @relation("ProviderAppointments")
  notesAuthored      Note[]              @relation("NoteAuthors")
  publicBookingLinks PublicBookingLink[]
  cancelReviews      CancelRequest[]     @relation("CancelReviewer")
  messagesSent       Message[]           @relation("MessageSender")
  messagesReceived   Message[]           @relation("MessageRecipient")
  notifications      Notification[]
  assessmentsTaken   Assessment[]
}

model Patient {
  id String @id @default(cuid())

  firstName String
  lastName  String
  phone     String?
  email     String?
  notesText String?
  birthDate DateTime?
  idNumber  String?

  status               PatientStatus @default(CANDIDATE)
  patientType          PatientType   @default(PRIVATE)
  reminderEmailEnabled Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String?
  owner   User?   @relation("PatientOwner", fields: [ownerId], references: [id])

  portalUser       User?             @relation("PortalAccount")
  appointments     Appointment[]
  notes            Note[]
  cancelRequests   CancelRequest[]
  groupMemberships GroupMember[]
  attendance       GroupAttendance[]
  assignedResources PatientResource[]
  treatmentPlans    TreatmentPlan[]
  assessments       Assessment[]

  @@index([status])
  @@index([lastName, firstName])
}

model Appointment {
  id String @id @default(cuid())

  patientId  String?
  providerId String

  startAt DateTime
  endAt   DateTime
  status  AppointmentStatus @default(SCHEDULED)
  kind    AppointmentKind   @default(APPOINTMENT)

  title       String?
  meetingType MeetingType @default(IN_PERSON)
  meetingLink String?

  isRecurring             Boolean   @default(false)
  recurrenceIntervalWeeks Int?
  recurrenceEndDate       DateTime?
  recurrenceGroupId       String?
  reminderSentAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient        Patient?              @relation(fields: [patientId], references: [id], onDelete: SetNull)
  provider       User                  @relation("ProviderAppointments", fields: [providerId], references: [id])
  exceptions     RecurrenceException[]
  cancelRequests CancelRequest[]

  @@index([startAt, status])
  @@index([patientId, startAt])
  @@index([providerId, startAt])
}

model RecurrenceException {
  id              String                  @id @default(cuid())
  appointmentId   String
  occurrenceStart DateTime
  kind            RecurrenceExceptionKind
  newStartAt      DateTime?
  newEndAt        DateTime?

  createdAt DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, occurrenceStart])
}

model PublicBookingLink {
  id          String  @id @default(cuid())
  token       String  @unique
  createdById String
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id])
}

model Note {
  id String @id @default(cuid())

  patientId String
  authorId  String

  content          String
  sessionNumber    Int?
  noteDate         DateTime?
  keyTopics        String?
  shareWithPatient Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  author  User    @relation("NoteAuthors", fields: [authorId], references: [id])

  @@index([patientId, createdAt])
}

model CancelRequest {
  id              String              @id @default(cuid())
  appointmentId   String
  patientId       String
  reason          String
  status          CancelRequestStatus @default(PENDING)
  occurrenceStart DateTime?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("CancelReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
}

model Message {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  sender    User @relation("MessageSender", fields: [senderId], references: [id])
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id])

  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
}

model Notification {
  id              String               @id @default(cuid())
  recipientUserId String
  title           String
  body            String
  category        NotificationCategory @default(SYSTEM)
  readAt          DateTime?
  createdAt       DateTime             @default(now())

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  @@index([recipientUserId, createdAt])
}

model TherapyGroup {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  GroupMember[]
  sessions GroupSession[]
}

model GroupMember {
  id        String    @id @default(cuid())
  groupId   String
  patientId String
  leftAt    DateTime?
  createdAt DateTime  @default(now())

  group   TherapyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  patient Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([groupId, patientId])
}

model GroupSession {
  id        String             @id @default(cuid())
  groupId   String
  startAt   DateTime
  endAt     DateTime
  status    GroupSessionStatus @default(SCHEDULED)
  summary   String?
  createdAt DateTime           @default(now())

  group      TherapyGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendance GroupAttendance[]
  @@index([groupId, startAt])
}

model GroupAttendance {
  id        String           @id @default(cuid())
  sessionId String
  patientId String
  status    AttendanceStatus @default(PENDING)
  note      String?

  session GroupSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  patient Patient      @relation(fields: [patientId], references: [id])

  @@unique([sessionId, patientId])
}

model ResourceFolder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())

  parent   ResourceFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children ResourceFolder[] @relation("FolderTree")
  resources Resource[]
}

model Resource {
  id                    String   @id @default(cuid())
  title                 String
  description           String?
  url                   String
  folderId              String?
  isPublic              Boolean  @default(false)
  allowPatientView      Boolean  @default(true)
  allowPatientDownload  Boolean  @default(true)
  notifyOnAssign        Boolean  @default(true)
  createdAt             DateTime @default(now())

  folder      ResourceFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  assignments PatientResource[]
}

model PatientResource {
  patientId  String
  resourceId String
  assignedAt DateTime @default(now())

  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([patientId, resourceId])
}

model TreatmentPlan {
  id                    String              @id @default(cuid())
  patientId             String
  diagnosisCode         String?
  diagnosisDescription  String?
  problemStatement      String?
  strengths             String?
  notes                 String?
  status                TreatmentPlanStatus @default(ACTIVE)
  shareWithPatient      Boolean             @default(false)
  reviewDate            DateTime?
  nextReviewDate        DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  patient Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  goals   TreatmentPlanGoal[]
  @@index([patientId, status])
}

model TreatmentPlanGoal {
  id                 String     @id @default(cuid())
  planId             String
  goalNumber         Int
  description        String
  objectives         String?
  interventions      String?
  targetDate         DateTime?
  status             GoalStatus @default(ACTIVE)
  progressPercentage Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  plan TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model AssessmentType {
  id             String  @id @default(cuid())
  key            String  @unique
  name           String
  description    String?
  descriptionHe  String?
  minScore       Int
  maxScore       Int
  isActive       Boolean @default(true)
  /// JSON: questions [{en,he}], options [{value,en,he}], bands [{min,max,severity,en,he}]
  definitionJson String?

  assessments Assessment[]
}

model Assessment {
  id             String   @id @default(cuid())
  patientId      String
  typeId         String
  takenById      String
  answersJson    String
  /// Snapshot of question labels at take time
  questionsJson  String?
  totalScore     Int
  severityLevel  String
  interpretation String
  notes          String?
  takenAt        DateTime @default(now())

  patient Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type    AssessmentType @relation(fields: [typeId], references: [id])
  takenBy User           @relation(fields: [takenById], references: [id])

  @@index([patientId, takenAt])
}

model ContactInquiry {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([createdAt])
}
